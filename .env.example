# Copy to .env.local and fill in. This file is the canonical list of env vars.
# In GitHub Codespaces, set the secret ones under repo Settings -> Secrets and
# variables -> Codespaces instead (see .devcontainer/README.md). The DB-driven
# slices run with only DATABASE_URL; everything below is per-integration.

DATABASE_URL=postgres://USER@localhost:5432/cdla_dev

# Stytch — magic link auth for the matches page
# Get these from https://stytch.com -> your project -> API Keys
# Register the magic-link redirect URL `http://localhost:3000/authenticate`
# (and the production equivalent) in the Stytch dashboard.
STYTCH_PROJECT_ID=
STYTCH_SECRET=
STYTCH_PUBLIC_TOKEN=
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=

# Public base URL — used to build the magic-link redirect.
# Defaults to http://localhost:3000 in dev; set to https://cdla.jobs in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GoHighLevel — inbound webhook URL for the /partners/brief carrier lead form.
# Optional once the direct-API path below is configured. Kept as a fallback.
GHL_CARRIER_LEAD_WEBHOOK_URL=

# GoHighLevel Private Integration token — scopes: contacts.write,
# locations/tags.write, conversations/message.write. Settings ->
# Private Integrations -> Create. Never paste in chat or commit to git.
GHL_API_TOKEN=

# GoHighLevel sub-account location ID. Settings -> Business Profile,
# or copy from any GHL URL containing /location/<id>/.
GHL_LOCATION_ID=

# Public URL of the carrier brief PDF. Upload the PDF to GHL Media Library
# (Marketing -> Media) and paste the returned URL here, or self-host at a
# stable public URL. If blank, the email sends without an attachment.
GHL_BRIEF_PDF_URL=

# Vercel cron auth secret. Vercel sends this as
# Authorization: Bearer <CRON_SECRET> on every scheduled invocation; the
# /api/cron/nurture handler refuses anything else. Generate a random
# 32+ char string (e.g., `openssl rand -hex 32`) and set the same value
# on Vercel project settings.
CRON_SECRET=

# Admin panel + unsubscribe link signing. Generate random 32+ char strings
# (`openssl rand -hex 32`). ADMIN_TOKEN gates /admin; UNSUBSCRIBE_SECRET signs
# the one-click email opt-out links.
ADMIN_TOKEN=
UNSUBSCRIBE_SECRET=

# Resend — transactional + nurture email. https://resend.com -> API Keys.
# CDLA_SENDER_ADDRESS is the verified From address (e.g. hello@cdla.jobs).
RESEND_API_KEY=
CDLA_SENDER_ADDRESS=

# LLM providers for the content machine / Debbie. Set whichever the enabled
# features use. ANTHROPIC_BASE_URL and ANTHROPIC_MODEL are optional overrides.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Vercel Blob — file uploads (e.g. carrier brief assets). Project -> Storage ->
# Blob -> connect, then copy the read/write token.
BLOB_READ_WRITE_TOKEN=

# Adzuna — job-listing polling. https://developer.adzuna.com -> register an app.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Feature flags (default off). Flip to "true" to enable; most also need the
# matching secrets above: CONTENT_MACHINE_ENABLED, GSC_INTEGRATION_ENABLED,
# TA_SYNC_ENABLED, QUICKBASE_PUSH_ENABLED, DEBBIE_AUDIO_ENABLED,
# DEBBIE_RESUME_ENABLED. See the referencing code for the extra vars each needs
# (Smartsheet, Quickbase, Google indexing, IndexNow, etc.).
#
# ADVISOR_MODE_ENABLED — turns Debbie into the honest advisor: driver
#   strengths/weaknesses assessment, ranked #1 + backups with fit reasons,
#   and the recruiter-style chat preamble. OFF = the neutral matcher
#   (unchanged). Do NOT flip on in prod until the advisor consent-scope
#   items are confirmed cleared (see the build plan's risk note).
# PROACTIVE_SENDS_ENABLED — turns on actual delivery for the lifelong
#   advocate proactive contacts (step-up / stay-put / re-match / milestone).
#   OFF = triggers + governance compute and record decisions but nothing is
#   sent. Keep OFF until A2P 10DLC SMS registration is confirmed live AND
#   the channel delivery in src/lib/proactive/run.ts is implemented.
# ADVISOR_MODE_ENABLED=
# PROACTIVE_SENDS_ENABLED=
