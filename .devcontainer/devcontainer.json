{
  "name": "cdla-job-finder",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // Heavy-lifting machine. Sets the MINIMUM Codespace size, so GitHub defaults
  // to (and only offers) 4-core/16GB or larger — comfortable for Next 16 +
  // Postgres + several projects open at once.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  // Next dev server. Codespaces auto-forwards and opens a preview tab.
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Next dev", "onAutoForward": "openPreview" }
  },

  // Runs once when the Codespace is created (and on rebuild):
  // install deps, apply Drizzle migrations, seed example carriers.
  "postCreateCommand": "npm install && npm run db:migrate && npm run db:seed",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
